# Copy to .env.local for local work. Never commit real values. See docs/implementation/OWNER_TEST_GUIDE.md.

# guest | supabase. "supabase" lets the browser try a private anonymous Supabase session (falls back to browser-only).
AUTH_MODE=guest

# fixture (labelled examples only) | duffel_test (real Duffel sandbox; needs a TEST token)
PROVIDER_MODE=fixture

# Server-only. Must start with duffel_test_ or the Duffel adapter stays disabled.
DUFFEL_ACCESS_TOKEN=

# Server-only. Gemini API key for AI explanations (deterministic fallback when empty).
GEMINI_API_KEY=

# Browser-safe Supabase values (publishable key only; never a secret/service key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local only, for `supabase db push/migration list` against the hosted project. Never set in Vercel.
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# on (default) | off. Off = bundled FX snapshot only (no network).
FX_LIVE=on

# Best-effort per-instance limit for search, plan and test-order requests per IP per minute.
RATE_LIMIT_PER_MIN=20
