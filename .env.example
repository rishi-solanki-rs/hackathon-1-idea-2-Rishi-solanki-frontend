# Copy to .env.local for local work. Never commit real values.

# guest (default, browser-local data) | supabase (only after TASK-003 passes)
AUTH_MODE=guest

# fixture (default, illustrative data) | duffel_test (needs a Duffel TEST token)
PROVIDER_MODE=fixture

# Server-only. Must start with duffel_test_ or the Duffel adapter stays disabled.
DUFFEL_ACCESS_TOKEN=

# on (default) | off. Off = bundled FX fixture only (no network).
FX_LIVE=on

# Best-effort per-instance limit for search and test-order requests per IP per minute.
RATE_LIMIT_PER_MIN=20
